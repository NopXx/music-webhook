# Server Configuration
PORT=3000
HOST=localhost

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/music-scrobbler
DB_NAME=music-scrobbler

# API Configuration
# Legacy global API key — accepted on /webhook (maps to the seeded admin user).
# Prefer per-user API keys created via POST /api/auth/api-keys.
API_KEY=your-api-key-here

# Auth (JWT + admin seed)
JWT_SECRET=change-me-to-a-long-random-string   # required in production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com                   # seeded on boot if user doesn't exist
ADMIN_PASSWORD=change-me-strong-password

# Environment
NODE_ENV=development

# CORS — comma-separated origins allowed to call the API (e.g. the dashboard SPA).
# Set this when the dashboard runs on a different origin; avoid '*' in production.
ALLOWED_ORIGINS=http://localhost:5173

# Debug Options (development only)
DEBUG_WEBHOOKS=false
DEBUG_VALIDATION=false

# Spotify API Configuration
# Get these from https://developer.spotify.com/dashboard
# 1. Go to https://developer.spotify.com/dashboard
# 2. Create a new app
# 3. Copy the Client ID and Client Secret
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Spotify Options
SPOTIFY_FETCH_AUDIO_FEATURES=false  # Set to true to fetch audio features for tracks (optional, increases API calls)
SCROBBLE_DEDUPE=off  # off, basic, strict - Controls duplicate detection

# Redis Configuration (optional — everything works without it, just slower)
# REDIS_URL=redis://localhost:6379
